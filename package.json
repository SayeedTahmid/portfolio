{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "content:index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-content-index.ts",
    "postinstall": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-content-index.ts",
    "predev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-content-index.ts",
    "dev": "next dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-content-index.ts",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-content-index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "prelint": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-content-index.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-contrast.ts",
    "prevalidate:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-content-index.ts",
    "validate:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-content.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:contrast && npm run validate:content && npm run build",
    "pretest:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-content-index.ts",
    "test:e2e": "playwright test",
    "test:e2e:full": "npm run build && playwright test"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "6.0.3"
  }
}
